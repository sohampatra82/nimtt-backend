<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Admission Form</title>
    <link rel="shortcut icon"
        href="https://ik.imagekit.io/7de5cntkw/1692626704665-photoaidcom-cropped%20(1).jpeg?updatedAt=1738048156918"
        type="image/x-icon">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary: #1a3c34;
            --primary-dark: #15332d;
            --light-bg: #f5f7fa;
            --card-bg: #ffffff;
        }

        * {
            box-sizing: border-box;
        }

        body {
            font-family: 'Poppins', sans-serif;
            margin: 0;
            padding: 16px;
            background-color: var(--light-bg);
            color: #333;
            line-height: 1.5;
            font-size: 15px;
        }

        .admission {
            max-width: 1100px;
            margin: 0 auto;
            background: var(--card-bg);
            padding: 20px;
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
        }

        .header {
            display: flex;
            flex-direction: column;
            gap: 20px;
            align-items: center;
            text-align: center;
            border-bottom: 2px solid #e0e0e0;
            padding-bottom: 20px;
            margin-bottom: 30px;
        }

        .header img {
            max-width: 160px;
            height: auto;
        }

        .header .company-details {
            text-align: center;
        }

        .header .company-details h1 {
            margin: 8px 0 0;
            font-size: clamp(20px, 5.5vw, 28px);
            font-weight: 600;
            color: var(--primary);
        }

        .header .company-details p {
            margin: 4px 0;
            font-size: 14px;
            color: #555;
        }

        h2 {
            font-size: clamp(18px, 4.8vw, 20px);
            font-weight: 500;
            color: var(--primary);
            border-bottom: 1px solid #e0e0e0;
            padding-bottom: 8px;
            margin: 32px 0 20px;
        }

        .form-group {
            margin-bottom: 20px;
        }

        label {
            display: block;
            margin-bottom: 6px;
            font-size: 14px;
            font-weight: 500;
            color: #333;
        }

        input[type="text"],
        input[type="email"],
        input[type="number"],
        input[type="date"],
        input[type="file"],
        select,
        textarea {
            width: 100%;
            padding: 10px 12px;
            border: 1px solid #d0d0d0;
            border-radius: 6px;
            font-size: 15px;
            font-family: inherit;
            background-color: #fafafa;
            transition: border-color 0.2s;
        }

        input:focus,
        select:focus,
        textarea:focus {
            border-color: var(--primary);
            outline: none;
        }

        .form-row {
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        .radio-group {
            display: flex;
            flex-wrap: wrap;
            gap: 16px;
            align-items: center;
        }

        .submit-btn {
            display: block;
            margin: 32px auto 0;
            background-color: var(--primary);
            color: white;
            padding: 12px 48px;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            font-size: 16px;
            font-weight: 500;
            font-family: inherit;
            transition: background-color 0.2s;
        }

        .submit-btn:hover,
        .submit-btn:focus {
            background-color: var(--primary-dark);
        }

        .note {
            font-size: 13px;
            color: #666;
            margin-top: 10px;
            font-style: italic;
        }

        .table-wrapper {
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
            margin-bottom: 24px;
        }

        table {
            width: 100%;
            min-width: 600px;
            border-collapse: collapse;
            font-size: 14px;
        }

        th,
        td {
            border: 1px solid #e0e0e0;
            padding: 10px;
            text-align: left;
        }

        th {
            background-color: #f8fafc;
            font-weight: 500;
        }

        .upload-group {
            margin-bottom: 28px;
        }

        /* ────────────────────────────────────────────────
           Responsive Design
        ──────────────────────────────────────────────── */

        @media (min-width: 480px) {
            body {
                padding: 20px;
            }

            .admission {
                padding: 28px;
            }
        }

        @media (min-width: 640px) {
            .form-row {
                flex-direction: row;
                flex-wrap: wrap;
            }

            .form-row>.form-group {
                flex: 1 1 45%;
            }

            .header {
                flex-direction: row;
                justify-content: space-between;
                text-align: left;
                align-items: center;
            }

            .header .company-details {
                text-align: right;
            }

            .header img {
                max-width: 170px;
            }
        }

        @media (min-width: 768px) {
            body {
                padding: 32px;
            }

            .admission {
                padding: 36px;
            }

            .header img {
                max-width: 180px;
            }

            .form-row>.form-group {
                flex: 1 1 30%;
            }

            h2 {
                font-size: 20px;
            }

            .radio-group {
                gap: 20px;
            }
        }

        @media (min-width: 1024px) {
            .admission {
                padding: 40px 60px;
            }

            .form-row>.form-group {
                flex-basis: auto;
                flex-grow: 1;
            }

            .radio-group {
                gap: 24px;
            }

            .submit-btn {
                padding: 14px 80px;
            }
        }

        /* Better touch targets & mobile readability */
        @media (max-width: 640px) {

            input,
            select,
            button,
            textarea {
                font-size: 16px;
                /* Prevents iOS zoom on focus */
                padding: 12px 14px;
            }

            .submit-btn {
                width: 100%;
                padding: 14px 20px;
            }

            .radio-group {
                flex-direction: column;
                align-items: flex-start;
                gap: 12px;
            }
        }
    </style>
</head>

<body>
    <div class="admission">

        <!-- Header Section -->
        <div class="header">
            <img src="https://ik.imagekit.io/7de5cntkw/nimtt-newlogo-dOqN8yQvbaHopnp3.avif?updatedAt=1746554872837"
                alt="Logo">
            <div class="company-details">
                <h1>National Institute Of Management <br> & Technical Training</h1>
                <p>Contact: +91-1234567890</p>
                <p>Email: info@nimtt.co.in</p>
                <p>Address: Kolkata, West Bengal, India</p>
            </div>
        </div>

        <!-- Admission Form -->
        <form method="post" action="/online-admission" enctype="multipart/form-data">

            <h2>Course/Programme Details</h2>
            <div class="form-group">
                <label for="programme">Programme Name *</label>
                <select id="programme" name="programme" required>
                    <option value="">Select</option>
                    <option value="iti-course">ITI</option>
                    <option value="diploma-engineering">Diploma in Engineering</option>
                    <option value="btech">B.Tech</option>
                    <option value="integrated-btech">Integrated B.Tech</option>
                    <option value="mtech">M.Tech</option>
                    <option value="bba">BBA</option>
                    <option value="mba">MBA</option>
                    <option value="bca">BCA</option>
                    <option value="mca">MCA</option>
                    <option value="bsc">B.Sc</option>
                    <option value="bsc-computer-science">B.Sc in Computer Science</option>
                    <option value="bsc-it">B.Sc IT</option>
                    <option value="msc-it">M.Sc IT</option>
                    <option value="msc-computer-science">M.Sc in Computer Science</option>
                    <option value="ba">BA</option>
                    <option value="bcom">B.Com</option>
                    <option value="pg-diploma">PG Diploma</option>
                    <option value="llb">LLB</option>
                    <option value="llm">LLM</option>
                    <option value="bsc-nursing">B.Sc Nursing</option>
                    <option value="gnm">GNM (General Nursing & Midwifery)</option>
                    <option value="bfa">BFA</option>
                    <option value="mfa">MFA</option>
                    <option value="bsw">BSW (Bachelor of Social Work)</option>
                    <option value="mfw">MFW</option>
                    <option value="bsc">B.Sc (General)</option>
                    <option value="msc">M.Sc (General)</option>
                    <option value="msc-nursing">M.Sc Nursing</option>
                    <option value="diploma-nursing-assistant">Diploma in Nursing Assistant</option>
                    <option value="post-basic-bsc-nursing">Post Basic B.Sc Nursing</option>
                    <option value="bmlt">BMLT (Bachelor in Medical Lab Technology)</option>
                    <option value="mmlt">MMLT</option>
                    <option value="boot">BOOT</option>
                    <option value="moot">MOOT</option>
                    <option value="bnys">BNYS</option>
                    <option value="diploma-homeo-pharma">Diploma in Homeo Pharmacy</option>
                    <option value="bsc-homeo-pharma">B.Sc in Homeo Pharmacy</option>
                    <option value="dnys">DNYS</option>
                    <option value="mphil">M.Phil</option>
                    <option value="phd">PhD (Doctor of Philosophy)</option>
                    <option value="dlitt">D.Litt</option>
                    <option value="dsc">D.Sc</option>
                    <option value="dpharma">D-Pharma</option>
                    <option value="bpharma">B-Pharma</option>
                    <option value="mpharma">M-Pharma</option>
                    <option value="other">Other</option>
                </select>
            </div>

            <div class="form-group">
                <label for="session">Session/Year *</label>
                <select id="session" name="session" required>
                    <option value="">Select</option>
                    <option value="2022-2023">2022-2023</option>
                    <option value="2023-2024">2023-2024</option>
                    <option value="2024-2025">2024-2025</option>
                    <option value="2025-2026">2025-2026</option>
                    <option value="2026-2027">2026-2027</option>
                </select>
            </div>

            <div class="form-group">
                <label for="subject">Subject / Specialization *</label>
                <input type="text" id="subject" name="subject"
                    placeholder="e.g., Computer Science, Mechanical, Finance, etc." required>
            </div>

            <h2>Personal Information</h2>
            <p class="note">*Note - All documents are included except "Category" (not required).</p>

            <div class="form-group">
                <label>Gender *</label>
                <div class="radio-group">
                    <label><input type="radio" name="gender" value="male" required> Male</label>
                    <label><input type="radio" name="gender" value="female" required> Female</label>
                    <label><input type="radio" name="gender" value="other" required> Other</label>
                </div>
            </div>

            <div class="form-group">
                <label>Date of Birth *</label>
                <div class="form-row">
                    <div class="form-group">
                        <select name="dob_month" required>
                            <option value="">Month</option>
                            <option value="jan">January</option>
                            <option value="feb">February</option>
                            <option value="mar">March</option>
                            <option value="apr">April</option>
                            <option value="may">May</option>
                            <option value="jun">June</option>
                            <option value="jul">July</option>
                            <option value="aug">August</option>
                            <option value="sep">September</option>
                            <option value="oct">October</option>
                            <option value="nov">November</option>
                            <option value="dec">December</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <select name="dob_day" required>
                            <option value="">Day</option>
                            <option value="1">1</option>
                            <option value="2">2</option>
                            <option value="3">3</option>
                            <option value="4">4</option>
                            <option value="5">5</option>
                            <option value="6">6</option>
                            <option value="7">7</option>
                            <option value="8">8</option>
                            <option value="9">9</option>
                            <option value="10">10</option>
                            <option value="11">11</option>
                            <option value="12">12</option>
                            <option value="13">13</option>
                            <option value="14">14</option>
                            <option value="15">15</option>
                            <option value="16">16</option>
                            <option value="17">17</option>
                            <option value="18">18</option>
                            <option value="19">19</option>
                            <option value="20">20</option>
                            <option value="21">21</option>
                            <option value="22">22</option>
                            <option value="23">23</option>
                            <option value="24">24</option>
                            <option value="25">25</option>
                            <option value="26">26</option>
                            <option value="27">27</option>
                            <option value="28">28</option>
                            <option value="29">29</option>
                            <option value="30">30</option>
                            <option value="31">31</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <select name="dob_year" id="dob_year" required>
                            <option value="">Year</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label for="applicant-name">Name of Applicant *</label>
                <input type="text" id="applicant-name" name="applicant_name" required>
            </div>

            <div class="form-group">
                <label for="father-name">Father Name *</label>
                <input type="text" id="father-name" name="father_name" required>
            </div>

            <div class="form-group">
                <label for="mother-name">Mother Name *</label>
                <input type="text" id="mother-name" name="mother_name" required>
            </div>

            <div class="form-group">
                <label for="aadhar">Aadhar Number *</label>
                <input type="text" id="aadhar" name="aadhar_number" required>
            </div>

            <div class="form-group">
                <label for="email">Email Id *</label>
                <input type="email" id="email" name="email" required>
            </div>

            <div class="form-group">
                <label for="nationality">Nationality *</label>
                <input type="text" id="nationality" name="nationality" required>
            </div>

            <div class="form-group">
                <label>Domicile *</label>
                <div class="radio-group">
                    <label><input type="radio" name="domicile" value="west_bengal" required> West Bengal</label>
                    <label><input type="radio" name="domicile" value="maharashtra" required> Maharashtra</label>
                    <label><input type="radio" name="domicile" value="other" required> Other</label>
                </div>
                <input type="text" id="domicile-others" name="domicile_others" placeholder="In Case of others, Specify"
                    style="margin-top: 12px;">
            </div>

            <h2>Contact Details</h2>
            <div class="form-group">
                <label for="address">Permanent Address *</label>
                <textarea id="address" name="permanent_address" rows="4" required></textarea>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label for="city">City *</label>
                    <input type="text" id="city" name="city" required>
                </div>
                <div class="form-group">
                    <label for="state">State *</label>
                    <input type="text" id="state" name="state" required>
                </div>
                <div class="form-group">
                    <label for="pin">Pin Code *</label>
                    <input type="text" id="pin" name="pin_code" required>
                </div>
            </div>

            <div class="form-group">
                <label for="mobile">Permanent Mobile Number *</label>
                <input type="text" id="mobile" name="mobile_number" required>
            </div>

            <h2>Qualifying Examination Details *</h2>
            <div class="table-wrapper">
                <table>
                    <tr>
                        <th>Examination</th>
                        <th>Percentage (%)</th>
                        <th>Subject/Stream</th>
                    </tr>
                    <tr>
                        <td>10th</td>
                        <td><input type="number" step="0.01" name="exam_10th_percentage"></td>
                        <td><input type="text" name="exam_10th_stream"></td>
                    </tr>
                    <tr>
                        <td>12th</td>
                        <td><input type="number" step="0.01" name="exam_12th_percentage"></td>
                        <td><input type="text" name="exam_12th_stream"></td>
                    </tr>
                    <tr>
                        <td>Graduation</td>
                        <td><input type="number" step="0.01" name="exam_graduation_percentage"></td>
                        <td><input type="text" name="exam_graduation_stream"></td>
                    </tr>
                    <tr>
                        <td>Post Graduation</td>
                        <td><input type="number" step="0.01" name="exam_postgrad_percentage"></td>
                        <td><input type="text" name="exam_postgrad_stream"></td>
                    </tr>
                </table>
            </div>

            <h2>Upload Documents</h2>
            <div class="upload-group">
                <label for="photo">1. Recent Passport Size Photograph *</label>
                <input type="file" id="photo" name="photo" accept="image/*" required>
                <p class="note">Max size: 2MB (JPG / PNG)</p>
            </div>

            <div class="upload-group">
                <label for="last_qualification">2. Last Qualifying Examination Marksheet / Certificate *</label>
                <input type="file" id="last_qualification" name="last_qualification" accept=".pdf,.jpg,.jpeg,.png"
                    required>
                <p class="note">Max size: 2MB (PDF / Image)</p>
            </div>

            <div class="upload-group">
                <label for="aadhar_doc">3. e-Aadhaar / Aadhaar Card (self-attested) *</label>
                <input type="file" id="aadhar_doc" name="aadhar_doc" accept=".pdf,.jpg,.jpeg,.png" required>
                <p class="note">Max size: 2MB (PDF / Image)</p>
            </div>

            <!-- <div class="upload-group">
                <label for="other_docs">4. Other Documents (if any)</label>
                <input type="file" id="other_docs" name="other_docs" accept=".pdf,.jpg,.jpeg,.png" multiple>
                <p class="note">e.g., Caste Certificate, Domicile Certificate, etc. (Max size per file: 5MB)</p>
            </div> -->

            <p class="note">*Note - All uploaded documents should be clear and readable. You may submit additional
                self-attested documents later on visiting the campus if required.</p>

            <h2>Declaration by Candidate</h2>
            <p>I hereby declare that I have carefully read the instructions and all the information furnished by me are
                correct.</p>

            <button type="submit" class="submit-btn">Submit</button>

        </form>
    </div>

    <script>
        const yearSelect = document.getElementById("dob_year");
        const currentYear = new Date().getFullYear();
        const startYear = 1950;

        for (let year = currentYear; year >= startYear; year--) {
            let option = document.createElement("option");
            option.value = year;
            option.textContent = year;
            yearSelect.appendChild(option);
        }
    </script>
</body>

</html>